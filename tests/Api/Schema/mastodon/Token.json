{
	"description": "Token (docs.joinmastodon.org/entities/Token). created_at is a Unix timestamp, an integer — the one date in the API that is not a string.",
	"type": "object",
	"required": [
		"access_token",
		"created_at",
		"scope",
		"token_type"
	],
	"properties": {
		"access_token": {
			"type": "string",
			"minLength": 1
		},
		"token_type": {
			"const": "Bearer"
		},
		"scope": {
			"type": "string",
			"minLength": 1
		},
		"created_at": {
			"type": "integer",
			"minimum": 0
		}
	}
}
