{
	"description": "CredentialAccount: an Account with source, the account's own view of itself (docs.joinmastodon.org/entities/Account/#CredentialAccount).",
	"allOf": [
		{
			"$ref": "Account"
		},
		{
			"type": "object",
			"required": [
				"source"
			],
			"properties": {
				"source": {
					"$ref": "CredentialAccount#/$defs/Source"
				},
				"role": {
					"$ref": "Role"
				}
			}
		}
	],
	"$defs": {
		"Source": {
			"type": "object",
			"required": [
				"fields",
				"follow_requests_count",
				"language",
				"note",
				"privacy",
				"sensitive"
			],
			"properties": {
				"note": {
					"type": "string"
				},
				"fields": {
					"type": "array",
					"items": {
						"$ref": "Account#/$defs/Field"
					}
				},
				"privacy": {
					"type": "string",
					"enum": [
						"public",
						"unlisted",
						"private",
						"direct"
					]
				},
				"sensitive": {
					"type": "boolean"
				},
				"language": {
					"type": [
						"string",
						"null"
					],
					"format": "language"
				},
				"follow_requests_count": {
					"type": "integer",
					"minimum": 0
				},
				"hide_collections": {
					"type": [
						"boolean",
						"null"
					]
				},
				"discoverable": {
					"type": [
						"boolean",
						"null"
					]
				},
				"indexable": {
					"type": "boolean"
				},
				"attribution_domains": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		}
	}
}
