{
	"description": "Suggestion (docs.joinmastodon.org/entities/Suggestion); source is the deprecated single reason.",
	"type": "object",
	"required": [
		"account",
		"source",
		"sources"
	],
	"properties": {
		"source": {
			"type": "string",
			"enum": [
				"staff",
				"past_interactions",
				"global"
			]
		},
		"sources": {
			"type": "array",
			"items": {
				"type": "string",
				"enum": [
					"featured",
					"most_followed",
					"most_interactions",
					"similar_to_recently_followed",
					"friends_of_friends"
				]
			},
			"minItems": 1
		},
		"account": {
			"$ref": "Account"
		}
	}
}
