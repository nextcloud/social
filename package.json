{
  "name": "social",
  "description": "Nextcloud becomes part of the federated social networks!",
  "version": "0.9.3.2",
  "authors": [
    {
      "name": "Benedikt Schächner",
      "email": "benedikt.schaechner@web.de",
      "homepage": "https://benedikt.xn--schchner-2za.de"
    }
  ],
  "license": "agpl",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development webpack --config webpack.common.js",
    "watch": "NODE_ENV=development webpack --progress --watch --config webpack.common.js",
    "build": "NODE_ENV=production webpack --progress --config webpack.common.js",
    "serve": "NODE_ENV=development webpack serve --progress --config webpack.common.js",
    "lint": "eslint --ext .js,.vue src",
    "lint:fix": "eslint --ext .js,.vue src --fix",
    "stylelint": "stylelint src",
    "stylelint:fix": "stylelint src --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "cypress": "npm run cypress:component && npm run cypress:e2e",
    "cypress:component": "cypress run --component",
    "cypress:e2e": "cypress run --e2e",
    "cypress:gui": "cypress open",
    "precypress:update-snapshots": "TESTING=true npm run dev"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.0.0",
    "@nextcloud/axios": "^2.3.0",
    "@nextcloud/dialogs": "^7.3.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/logger": "^3.0.3",
    "@nextcloud/moment": "^1.3.5",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.8.0",
    "@nextcloud/vue-richtext": "^2.0.4",
    "blurhash": "^2.0.5",
    "debounce": "^1.2.1",
    "he": "^1.2.0",
    "ical.js": "^2.2.1",
    "linkify-plugin-mention": "^4.1.0",
    "linkify-string": "^4.1.0",
    "linkifyjs": "^4.1.0",
    "mitt": "^3.0.1",
    "sass": "^1.59.2",
    "tributejs": "^5.1.3",
    "twemoji": "12.0.1",
    "uuid": "^8.3.2",
    "vue": "^3.4.0",
    "vue-material-design-icons": "^5.2.0",
    "vue-router": "^4.3.0",
    "vuex": "^4.1.0"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "browser": {
    "fs": false
  },
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@cypress/browserify-preprocessor": "^3.0.2",
    "@nextcloud/babel-config": "^1.0.0",
    "@nextcloud/browserslist-config": "^2.3.0",
    "@nextcloud/cypress": "^1.0.0-beta.2",
    "@nextcloud/eslint-config": "^8.4.2",
    "@nextcloud/stylelint-config": "^2.3.0",
    "@nextcloud/webpack-vue-config": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.34",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^7.1.4",
    "cypress-visual-regression": "^2.1.1",
    "cypress-wait-until": "^1.7.2",
    "dockerode": "^4.0.6",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-vue": "^10.9.1",
    "jest": "^29.5.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.7",
    "vue-loader": "^17.4.2",
    "wait-on": "^7.0.1",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "vue"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.js$": "<rootDir>/node_modules/babel-jest",
      ".*\\.(vue)$": "<rootDir>/node_modules/vue-jest"
    },
    "snapshotSerializers": [
      "<rootDir>/node_modules/jest-serializer-vue"
    ]
  }
}
